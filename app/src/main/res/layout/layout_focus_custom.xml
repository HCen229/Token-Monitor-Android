<?xml version="1.0" encoding="utf-8"?>
<!-- 焦点通知自定义布局 - 亮色模式 (严格对照草图排版) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/focus_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="15dp"
    android:paddingEnd="15dp"
    android:paddingTop="15dp"
    android:paddingBottom="15dp">

    <!-- 1. 顶栏：Logo + Title/Status + Host IP + 右侧更新时间戳微标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_exp_app_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="Token Monitor"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_brand_token_monitor" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_exp_title_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                tools:text="Token Monitor Σ · 工作中" />

            <TextView
                android:id="@+id/tv_exp_host_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:includeFontPadding="false"
                tools:text="已连接至 111.111.111.111" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_exp_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge_timestamp"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textColor="#4B5563"
            android:textSize="10sp"
            android:includeFontPadding="false"
            tools:text="更新于 15:06:00" />
    </LinearLayout>

    <!-- 2. 中栏：左侧"今日 Token"，右侧换算微标 (例如 300M) + 超大完整数值 (300,000,000) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_exp_today_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日 Token"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- 换算单位微标 (例如 300M) -->
            <TextView
                android:id="@+id/tv_exp_today_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_compact_tokens_light"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#0284C7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                tools:text="300M" />

            <!-- 完整未简写数值 (例如 300,000,000) -->
            <TextView
                android:id="@+id/tv_exp_today_tokens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                tools:text="300,000,000" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 分割线 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:background="#E5E7EB"
        android:contentDescription="@null" />

    <!-- 4. 底栏：双供应商模式 -->
    <LinearLayout
        android:id="@+id/layout_two_providers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 左侧供应商 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_provider_1_ring"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Provider 1 Ring"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_provider_1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#111827"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    tools:text="Antigravity" />

                <TextView
                    android:id="@+id/tv_provider_1_quota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#0284C7"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    tools:text="10% | 03:21:11 后重置" />

                <TextView
                    android:id="@+id/tv_provider_1_usage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#6B7280"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    tools:text="已使用 123M Token" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧供应商 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_provider_2_ring"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Provider 2 Ring"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_provider_2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#111827"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    tools:text="DeepSeek" />

                <TextView
                    android:id="@+id/tv_provider_2_quota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#059669"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    tools:text="79.92 ¥ | 正常时段" />

                <TextView
                    android:id="@+id/tv_provider_2_usage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#6B7280"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    tools:text="已使用 122M Token" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 5. 底栏：单供应商模式 (独占整行通栏，仅当只有1个供应商时显示) -->
    <LinearLayout
        android:id="@+id/layout_single_provider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_single_provider_ring"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Single Provider Ring"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_single_provider_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                tools:text="DeepSeek" />

            <TextView
                android:id="@+id/tv_single_provider_quota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#0284C7"
                android:textSize="11sp"
                android:includeFontPadding="false"
                tools:text="79.92 ¥ | 梁文峰时段" />

            <TextView
                android:id="@+id/tv_single_provider_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:includeFontPadding="false"
                tools:text="已使用 122M Token" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
